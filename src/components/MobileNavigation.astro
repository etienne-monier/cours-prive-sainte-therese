---
import { navigation } from "../config/navigation";
---

<div
  id="mobile-navigation"
  class="fixed inset-0 z-50 hidden lg:hidden"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-[2px]"
    data-mobile-menu-close
    aria-hidden="true"
  ></div>

  <!-- Drawer -->
  <aside
    class="relative flex h-full w-[min(88vw,380px)] flex-col
           overflow-y-auto bg-white shadow-xl"
    aria-label="Navigation mobile"
  >
    <!-- Drawer header -->
    <div
      class="flex items-center justify-between border-b border-border
             px-6 py-5"
    >
      <div>
        <span
          class="block font-serif text-xl font-semibold text-brand-primary"
        >
          Cours Sainte-Thérèse
        </span>

        <span
          class="mt-0.5 block font-sans text-[0.65rem] font-semibold
                 uppercase tracking-[0.18em] text-text-muted"
        >
          Navigation
        </span>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full
               text-brand-primary transition-colors
               hover:bg-brand-primary-light hover:text-brand-accent
               focus:outline-none focus:ring-2
               focus:ring-brand-accent/50"
        data-mobile-menu-close
        aria-label="Fermer le menu"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-4 py-6" aria-label="Navigation principale">
      <ul class="space-y-1">
        {
          navigation.map((item) => (
            <li>
              {item.children ? (
                <details class="group">
                  <summary
                    class="flex cursor-pointer list-none items-center
                           justify-between rounded-md px-3 py-3
                           font-sans text-base font-semibold
                           tracking-wide text-brand-primary
                           transition-colors
                           hover:bg-brand-primary-light
                           hover:text-brand-accent
                           [&::-webkit-details-marker]:hidden"
                  >
                    <span>{item.label}</span>

                    <svg
                      class="h-4 w-4 shrink-0 transition-transform
                             group-open:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10
                           11.168l3.71-3.938a.75.75 0 111.08
                           1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51
                           a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>

                  <ul
                    class="ml-3 mt-1 space-y-1 border-l-2
                           border-brand-accent-light py-1 pl-3"
                  >
                    {
                      item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="block rounded-md px-3 py-2.5
                                   font-sans text-sm font-medium
                                   text-text-muted transition-colors
                                   hover:bg-brand-primary-light
                                   hover:text-brand-primary"
                          >
                            {child.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  class="block rounded-md px-3 py-3
                         font-sans text-base font-semibold
                         tracking-wide text-brand-primary
                         transition-colors
                         hover:bg-brand-primary-light
                         hover:text-brand-accent"
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Drawer footer -->
    <div class="border-t border-border px-6 py-5">
      <p class="font-serif text-sm font-medium text-brand-primary">
        Cours Privé Sainte-Thérèse
      </p>

      <p class="mt-1 font-sans text-xs text-text-muted">
        Saverdun
      </p>
    </div>
  </aside>
</div>

<script>
  const navigation = document.querySelector("#mobile-navigation");

  const closeNavigation = () => {
    if (!navigation) return;

    navigation.classList.add("hidden");
    navigation.setAttribute("aria-hidden", "true");

    const button = document.querySelector("#mobile-menu-button");

    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Ouvrir le menu");
  };

  navigation?.querySelectorAll("[data-mobile-menu-close]").forEach((element) => {
    element.addEventListener("click", closeNavigation);
  });
</script>
