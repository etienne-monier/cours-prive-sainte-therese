---
import { withBase } from "../utils/url";
---

<footer class="border-t border-border bg-white">
  <!-- Main footer -->
  <div class="container-site py-10 sm:py-12">
    <div
      class="flex flex-col items-center gap-6
             text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <!-- School identity -->
      <div class="shrink-0">
        <p class="font-serif text-lg font-semibold text-brand-primary">
          Cours Privé Sainte-Thérèse
        </p>

        <p class="mt-1 font-sans text-sm text-text-muted">
          Établissement scolaire privé · Saverdun
        </p>
      </div>

      <!-- Contact information -->
      <address
        class="flex flex-col items-center gap-2 not-italic
               font-sans text-sm text-text-muted
               sm:flex-row sm:gap-6"
      >
        <a
          href="tel:+33561000000"
          class="transition-colors hover:text-brand-accent"
        >
          05 61 XX XX XX
        </a>

        <span class="hidden text-border sm:inline" aria-hidden="true">·</span>

        <a
          href="mailto:contact@coursprivesaintetherese.com"
          class="transition-colors hover:text-brand-accent"
        >
          contact@coursprivesaintetherese.com
        </a>
      </address>
    </div>
  </div>

  <!-- Legal links -->
  <div class="border-t border-border bg-surface">
    <div
      class="container-site flex flex-col items-center gap-3 py-4
             text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <p class="font-sans text-xs text-text-muted">
        © 2006–2026 Cours Privé Sainte-Thérèse
      </p>

      <nav aria-label="Liens secondaires">
        <ul
          class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2
                 font-sans text-xs text-text-muted"
        >
          <li>
            <a
              href={withBase("/mentions-legales/")}
              class="transition-colors hover:text-brand-accent"
            >
              Mentions légales
            </a>
          </li>

          <li>
            <a
              href={withBase("/confidentialite/")}
              class="transition-colors hover:text-brand-accent"
            >
              Confidentialité
            </a>
          </li>

          <li>
            <a
              href={withBase("/plan-du-site/")}
              class="transition-colors hover:text-brand-accent"
            >
              Plan du site
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
