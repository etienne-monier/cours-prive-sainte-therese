---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";
---

<Layout
  title="Page introuvable"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
>
  <div class="container-site py-20 text-center sm:py-28">
    <p
      class="font-sans text-sm font-semibold uppercase
             tracking-[0.18em] text-brand-accent"
    >
      Erreur 404
    </p>

    <h1 class="heading-section mt-4">Page introuvable</h1>

    <p class="mx-auto mt-4 max-w-xl font-sans text-lg text-text-muted">
      La page que vous cherchez n'existe pas ou a été déplacée.
    </p>

    <a href={withBase("/")} class="button-primary mt-8">Retour à l'accueil</a>
  </div>
</Layout>
